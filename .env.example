# Copy this file to .env.local and fill it in. .env.local is not committed.
# These are the values from: Firebase console > Project settings > Your apps > Web app > Config.
# They identify the project; they are not secrets. App Check is what protects the API.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# reCAPTCHA Enterprise site key (Google Cloud console > Security > reCAPTCHA). Used by App Check.
VITE_RECAPTCHA_ENTERPRISE_SITE_KEY=

# Optional. After the first `npm run dev`, the browser console prints an App Check debug token.
# Register it in the Firebase console, then paste it here so it stays the same on every run.
VITE_APPCHECK_DEBUG_TOKEN=
